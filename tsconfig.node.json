{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Estricto */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/e2e/**/*.ts",
    "tests/e2e-auth/**/*.ts",
    "tests/e2e-users/**/*.ts",
    "tests/e2e-clients-sites/**/*.ts",
    "tests/e2e-employees/**/*.ts",
    "tests/e2e-shifts-services/**/*.ts",
    "tests/e2e-assignments/**/*.ts",
    "tests/permissions/**/*.ts",
    "scripts/**/*.ts"
  ]
}
