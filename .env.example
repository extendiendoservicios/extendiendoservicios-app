# Variables de entorno del frontend (ver 03_Plan_Maestro_Tecnico.md sección 3.3).
# Copiar a .env.local y completar con los valores de App_dev. Nunca commitear
# un .env con valores reales.

# Cliente de Supabase. La anon key es pública por diseño: RLS protege los datos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# local | staging | production. Controla el banner de staging y el
# environment de Sentry.
VITE_APP_ENV=

# DSN del proyecto de Sentry (frontend).
VITE_SENTRY_DSN=

# Solo local, solo para scripts (seed-dev.ts, import-initial.ts) con la
# Admin API de Supabase. Nunca en el frontend ni en Pages: se salta RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional, solo para scripts/seed-dev.ts (DB-019): contraseña inicial de
# los usuarios ficticios de staging. Si no se define, usa el valor por
# defecto documentado en docs/database.md -- no es un secreto real, son
# cuentas de prueba que viven solo en App_dev.
SEED_DEV_PASSWORD=
