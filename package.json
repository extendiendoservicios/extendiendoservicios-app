{
  "name": "extendiendoservicios-app",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:auth": "pnpm build && node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=tests/e2e-auth/playwright.auth.config.ts",
    "test:e2e:users": "pnpm build && node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=tests/e2e-users/playwright.users.config.ts",
    "test:e2e:clients-sites": "pnpm build && node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=tests/e2e-clients-sites/playwright.clients-sites.config.ts",
    "test:e2e:employees": "pnpm build && node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=tests/e2e-employees/playwright.employees.config.ts",
    "test:e2e:shifts-services": "pnpm build && node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=tests/e2e-shifts-services/playwright.shifts-services.config.ts",
    "test:e2e:assignments": "pnpm build && node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=tests/e2e-assignments/playwright.assignments.config.ts",
    "test:e2e:checklists": "pnpm build && node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=tests/e2e-checklists/playwright.checklists.config.ts",
    "test:e2e:employee-shift": "pnpm build && node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=tests/e2e-employee-shift/playwright.employee-shift.config.ts",
    "test:permissions": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config tests/permissions/vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:push": "supabase db push",
    "db:types": "supabase gen types --linked > src/lib/database.types.ts",
    "db:test": "bash scripts/db-test.sh",
    "db:seed:users": "node --env-file=.env.local scripts/seed-dev.ts",
    "db:seed:data": "supabase db query --linked -f supabase/seed.sql",
    "db:seed": "pnpm db:seed:users && pnpm db:seed:data"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "5.9.1",
    "@sentry/react": "10.75.0",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.34.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.86.0",
    "react-leaflet": "5.0.0",
    "react-router": "7.18.4",
    "sonner": "2.0.8",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.99.0"
  }
}
